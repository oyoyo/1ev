---
const { posts = [] } = Astro.props;
const badge = (p:any) => p.channel === 'news'
  ? '<span class="badge badge-purple">新闻早报</span>'
  : '<span class="badge badge-green">出海日报</span>';
---
<div class="grid">{posts.map((p:any)=>(
  <article class="card">
    <div><span set:html={badge(p)} /><span class="meta tnum">{p.date}</span></div>
    <h2><a href={p.url}>{p.title}</a></h2>
    {p.bodyHtml && <div set:html={p.bodyHtml} />}
  </article>
))}
</div>
