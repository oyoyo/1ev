---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getCollection } from 'astro:content';

const fmtMD = (html:string) => {
  // keep only first 3 list items or first paragraphs as preview
  const matches = html.match(/<li>[\s\S]*?<\/li>/g) || [];
  return matches.length ? '<ul>' + matches.slice(0,3).join('') + '</ul>' : '';
};
async function load(coll:string, channel:string){
  const entries = await getCollection(coll as any);
  return entries.map((e:any)=>({
    title: e.data.title, date: e.data.date, channel,
    url: `/${channel}/${e.slug}/`,
    summary: e.data.summary || '',
    bodyHtml: fmtMD(e.body ? '' : '') // preview filled below via render
  })).sort((a:any,b:any)=> b.date.localeCompare(a.date));
}
// Build previews with rendered body
async function withPreview(coll:string, channel:string){
  const entries:any[] = await getCollection(coll as any);
  const out=[];
  for (const e of entries){
    const lines = (e.body??'').split('\n').filter((l:string)=>l.trim().startsWith('- ')).slice(0,3);
    out.push({ title:e.data.title, date:e.data.date, channel, url:`/${channel}/${e.id.replace(/\.md$/,'')}/`, summary:e.data.summary||'', bodyHtml: lines.length ? '<ul>'+lines.map((l:string)=>'<li>'+l.replace(/^- /,'')+'</li>').join('')+'</ul>' : '' });
  }
  return out.sort((a:any,b:any)=> b.date.localeCompare(a.date));
}
const news = await withPreview('news','news');
const auto = await withPreview('auto','auto');
const latestNews = news.slice(0,2);
const latestAuto = auto.slice(0,2);
const recent = [...news, ...auto].sort((a:any,b:any)=> b.date.localeCompare(a.date)).slice(0,6);
---
<Base>
  <p>每天两份简报：中文新闻早报与汽车出海日报。</p>
  <div class="grid">
    <div class="card"><h2>📰 每日新闻早报</h2>{latestNews[0] ? <p><a href={latestNews[0].url}>{latestNews[0].date} 最新版</a></p> : <p>暂无内容</p>}</div>
    <div class="card"><h2>🚗 汽车行业出海日报</h2>{latestAuto[0] ? <p><a href={latestAuto[0].url}>{latestAuto[0].date} 最新版</a></p> : <p>暂无内容</p>}</div>
  </div>
  <h2>最新</h2>
  <PostList posts={recent} />
</Base>
