---
import Base from '../layouts/Base.astro';
import { getAllPosts, getMonthIndex } from '../lib/posts';
import { getCollection } from 'astro:content';
import { renderBullet } from '../lib/links';

const all = await getAllPosts();
const months = await getMonthIndex();
const news = all.filter(p=>p.channel==='news');
const auto = all.filter(p=>p.channel==='auto');
const years = [...new Set(months.map((m:any)=> m.ym.slice(0,4)))];

function stripMd(s:string){
  return (s||'').replace(/^#{1,6}\s+/gm,'').replace(/\*\*/g,'').replace(/^- /gm,'').replace(/\[([^\]]+)\]\(([^)]+)\)/g,'$1').trim();
}
function preview(p:any){
  const lines = (p.body||'').split('\n').filter((l:string)=>l.trim().startsWith('- ')).slice(0,3);
  return lines.length ? '<ul>'+lines.map((l:string)=>'<li>'+renderBullet(l)+'</li>').join('')+'</ul>' : '';
}
function excerpt(p:any){
  const txt = stripMd((p.body||'').split('\n').filter((l:string)=>l.trim() && !l.startsWith('#')).join(' '));
  return txt.length > 180 ? txt.slice(0,180) + '…' : txt;
}
const latestNews = news.slice(0,1);
const latestAuto = auto.slice(0,1);
const recent = all.slice(0,8);
const hot = all.slice(0,5); // sidebar "最近"
---
<Base>
  <section class="hero">
    <h1>每日简报，一眼看懂世界。</h1>
    <!--p>每天 0:00 汇总国内要闻；1:00 更新汽车行业出海动态。</p-->
  </section>

  <div class="layout-2col">
    <div>
      <div class="grid" style="margin-bottom:8px">
        <article class="card">
          <div><span class="badge badge-purple">新闻早报</span><span class="meta tnum">{latestNews[0]?.date || ''}</span></div>
          <h2>{latestNews[0] ? <a href={latestNews[0].url}>{latestNews[0].title}</a> : '暂无内容'}</h2>
          {latestNews[0] && <div set:html={preview(latestNews[0])} />}
        </article>
        <article class="card">
          <div><span class="badge badge-green">汽车日报</span><span class="meta tnum">{latestAuto[0]?.date || ''}</span></div>
          <h2>{latestAuto[0] ? <a href={latestAuto[0].url}>{latestAuto[0].title}</a> : '暂无内容'}</h2>
          {latestAuto[0] && <div set:html={preview(latestAuto[0])} />}
        </article>
      </div>
      <h2 class="section-title">最新简报</h2>
      <div class="rows">
        {recent.map(p=>(
          <div class="row">
            <span class="date tnum">{p.date}</span>
            <span>{p.channel==='news' ? <span class="badge badge-purple">新闻</span> : <span class="badge badge-green">汽车</span>}</span>
            <a href={p.url}>{p.title}</a>
          </div>
        ))}
      </div>
      <div style="margin-top:20px"><a class="btn-ghost" href="/archive/">查看全部归档 →</a></div>
    </div>

    <aside class="rail">
      <div class="card">
        <h3>按年月</h3>
        {years.map(y=>(
          <div style="margin-bottom:12px">
            <div class="meta tnum" style="font-size:14px; color:var(--navy); margin-bottom:6px">{y} 年</div>
            <div>{months.filter((m:any)=>m.ym.startsWith(y)).map((m:any)=>(
              <a class="month-link" href={`/archive/${m.ym}/`}><span class="tnum">{m.ym}</span></a>
            ))}</div>
          </div>
        ))}
      </div>
      <div class="card">
        <h3>最近发布</h3>
        <ul>{hot.map(p=>(
          <li><a href={p.url}>{p.title}</a><div class="meta tnum">{p.date}</div></li>
        ))}</ul>
      </div>
      <div class="card">
        <h3>订阅</h3>
        <p class="meta">用 RSS 阅读器订阅最新简报</p>
        <a class="btn-ghost" href="/rss.xml">📡 RSS 订阅</a>
      </div>
    </aside>
  </div>
</Base>
