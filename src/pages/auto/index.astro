---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getAllPosts } from '../../lib/posts';
const all = (await getAllPosts()).filter(p=>p.channel==='auto');
const posts = all.map(p=>{
  const lines = (p.body||'').split('\n').filter((l:string)=>l.trim().startsWith('- ')).slice(0,3);
  return { ...p, bodyHtml: lines.length ? '<ul>'+lines.map((l:string)=>'<li>'+l.replace(/^- /,'')+'</li>').join('')+'</ul>' : '' };
});
---
<Base title="出海日报 | 1ev">
  <div class="hero"><h1>🚗 出海日报</h1><p>共 <span class="tnum">{all.length}</span> 篇，每日更新。</p></div>
  <PostList posts={posts} />
</Base>
